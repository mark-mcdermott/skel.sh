---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import Section from '../components/Section.astro'
import Terminal from '../components/Terminal.astro'
import CopyCommand from '../components/CopyCommand.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import cli from '../data/cli.json'
import mascot from '../assets/mascot.png'

// Synced from the skel repo's latest release by scripts/sync-cli.mjs and
// committed, so a build never depends on GitHub being reachable.
const version = cli.version
const repo = 'https://github.com/mark-mcdermott/skel'

const description =
  'Skel is a small bash utility that scaffolds files and directories from an indented tree. Type the structure you want, press enter, get it.'

const rules = [
  { text: 'Two spaces per indent level', note: 'or set your own with -i N' },
  { text: 'Directories end with / or are inferred from indentation', note: null },
  { text: 'Empty directories must end with /', note: null },
  { text: 'Paths stay relative', note: '/, ~ and .. are rejected' },
  { text: 'No tabs, no blank lines, no duplicate paths', note: null },
  { text: 'Files are created relative to the current directory', note: null },
]
---

<Base title="skel — scaffold a project by typing a tree" description={description}>
  <a
    href="#main"
    class="sr-only rounded-lg bg-fg px-4 py-2 font-mono text-sm text-surface focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50"
  >
    Skip to content
  </a>

  <header class="mx-auto flex w-full max-w-5xl items-center justify-between px-6 py-5">
    <div class="flex items-center gap-2.5">
      <Image src={mascot} alt="" width={20} densities={[1, 2]} loading="eager" aria-hidden="true" />
      <span class="font-mono text-sm font-medium tracking-tight">skel</span>
      <span
        class="rounded-full border border-edge px-2 py-0.5 font-mono text-[11px] text-fg-muted"
      >
        v{version}
      </span>
    </div>

    <div class="flex items-center gap-4">
      <a
        href={repo}
        class="font-mono text-sm text-fg-muted underline-offset-4 transition-colors hover:text-fg hover:underline"
      >
        GitHub
      </a>

      <ThemeToggle />
    </div>
  </header>

  <main id="main" tabindex="-1" class="focus:outline-none">
    <!-- Hero -->
    <div class="mx-auto w-full max-w-5xl px-6 pt-8 pb-16 sm:pt-16 sm:pb-24">
      <div class="grid items-center gap-10 sm:gap-14 md:grid-cols-[280px_1fr]">
        <Image
          src={mascot}
          alt="The skel mascot, a small smiling skeleton"
          width={280}
          densities={[1, 2]}
          loading="eager"
          class="mx-auto w-44 md:mx-0 md:w-full"
        />

        <div>
          <h1 class="font-display text-5xl font-bold tracking-tight sm:text-6xl">skel</h1>

          <p class="mt-4 max-w-md text-xl leading-snug text-balance text-fg-soft sm:text-2xl">
            Scaffold a project by typing a tree.
          </p>

          <p class="mt-4 max-w-md text-[15px] leading-relaxed text-fg-muted">
            A small bash utility. Type the file structure you want the way you'd sketch it on
            paper — indentation and all — and skel builds it.
          </p>

          <div class="mt-8 max-w-md">
            <CopyCommand command="brew install mark-mcdermott/skel/skel" variant="lead" />
          </div>

          <p class="mt-4 font-mono text-xs text-fg-muted">
            MIT · macOS &amp; Linux · <a
              href={repo}
              class="underline underline-offset-4 transition-colors hover:text-fg">source</a
            >
          </p>
        </div>
      </div>
    </div>

    <!-- The whole idea, in one before/after -->
    <Section id="demo" eyebrow="The idea" title="You type the tree. You get the tree.">
      <div class="grid gap-5 md:grid-cols-2">
        <div class="flex flex-col">
          <p class="mb-3 font-mono text-xs tracking-wide text-fg-muted">You type</p>
          <Terminal label="skel" class="flex-1">
<span class="text-white/50">$</span> skel
<span class="text-white/50">&gt;</span> src
<span class="text-white/50">&gt;</span>   main
<span class="text-white/50">&gt;</span>     index.ts
<span class="text-white/50">&gt;</span>   renderer
<span class="text-white/50">&gt;</span>     App.tsx
<span class="text-white/50">&gt;</span>     styles
<span class="text-white/50">&gt;</span>       global.css
<span class="text-white/50">&gt;</span> package.json
<span class="text-white/50">&gt;</span> vite.config.ts
<span class="text-white/50">&gt;</span> <span class="text-blush">▊</span>
          </Terminal>
        </div>

        <div class="flex flex-col">
          <p class="mb-3 font-mono text-xs tracking-wide text-fg-muted">You get</p>
          <Terminal label="tree" class="flex-1">
├── package.json
├── src
│   ├── main
│   │   └── index.ts
│   └── renderer
│       ├── App.tsx
│       └── styles
│           └── global.css
└── vite.config.ts
          </Terminal>
        </div>
      </div>

      <p class="mt-6 max-w-2xl text-[15px] leading-relaxed text-fg-muted">
        Press enter on a blank line to finish. Directories are inferred from indentation, so you
        only mark the empty ones. It reads piped input and heredocs too — <code
          class="font-mono text-fg-soft">skel &lt; structure.txt</code
        >.
      </p>
    </Section>

    <!-- Walkthrough -->
    <Section id="walkthrough" eyebrow="In motion" title="A minute of it working.">
      <!-- Capped at the recording's native 548px. Stretching it to the column
           width upscales 1.8x and turns the terminal text to mush; a smaller
           sharp video reads better than a big soft one. -->
      <div class="mx-auto max-w-[548px] overflow-hidden rounded-xl border border-edge bg-terminal">
        <video
          src="/walkthrough.mp4"
          poster="/walkthrough-poster.jpg"
          class="w-full"
          autoplay
          loop
          muted
          playsinline
          controls
          aria-label="Screen recording of skel scaffolding a project from an indented tree"
          data-demo-video></video>
      </div>
    </Section>

    <!-- Install -->
    <Section id="install" eyebrow="Install" title="Three ways in.">
      <div class="grid gap-8 md:grid-cols-3">
        <div>
          <h3 class="mb-1 font-mono text-sm font-medium">Homebrew</h3>
          <p class="mb-4 text-sm text-fg-muted">Recommended.</p>
          <div class="space-y-2">
            <CopyCommand command="brew tap mark-mcdermott/skel" />
            <CopyCommand command="brew install skel" />
          </div>
        </div>

        <div>
          <h3 class="mb-1 font-mono text-sm font-medium">Install script</h3>
          <p class="mb-4 text-sm text-fg-muted">Installs to /usr/local/bin.</p>
          <div class="space-y-2">
            <CopyCommand command="git clone https://github.com/mark-mcdermott/skel.git" />
            <CopyCommand command="cd skel && ./install.sh" />
          </div>
        </div>

        <div>
          <h3 class="mb-1 font-mono text-sm font-medium">Make</h3>
          <p class="mb-4 text-sm text-fg-muted">Same, via the Makefile.</p>
          <div class="space-y-2">
            <CopyCommand command="git clone https://github.com/mark-mcdermott/skel.git" />
            <CopyCommand command="cd skel && make install" />
          </div>
        </div>
      </div>
    </Section>

    <!-- Rules -->
    <Section id="syntax" eyebrow="Syntax" title="The whole ruleset.">
      <ul class="grid max-w-3xl gap-px overflow-hidden rounded-xl border border-edge bg-edge">
        {
          rules.map((rule) => (
            <li class="flex flex-wrap items-baseline gap-x-2 bg-surface px-5 py-4">
              <span class="text-[15px] text-fg-soft">{rule.text}</span>
              {rule.note && <span class="font-mono text-xs text-fg-muted">{rule.note}</span>}
            </li>
          ))
        }
      </ul>
    </Section>
  </main>

  <footer class="border-t border-edge">
    <div
      class="mx-auto flex w-full max-w-5xl flex-wrap items-center justify-between gap-4 px-6 py-10"
    >
      <div class="flex items-center gap-2.5">
        <Image src={mascot} alt="" width={18} densities={[1, 2]} aria-hidden="true" />
        <span class="font-mono text-xs text-fg-muted">skel v{version} · MIT</span>
      </div>

      <div class="flex gap-5 font-mono text-xs text-fg-muted">
        <a href={repo} class="underline-offset-4 transition-colors hover:text-fg hover:underline">
          GitHub
        </a>
        <a
          href="https://markmcdermott.io"
          class="underline-offset-4 transition-colors hover:text-fg hover:underline"
        >
          Mark McDermott
        </a>
      </div>
    </div>
  </footer>

  <script>
    // A looping screen recording is exactly the kind of motion someone with
    // prefers-reduced-motion set has asked not to be given unprompted. CSS
    // can't stop autoplay, so it's paused here and left for them to start.
    const video = document.querySelector<HTMLVideoElement>('[data-demo-video]')

    if (video && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.autoplay = false
      video.pause()
    }
  </script>
</Base>
