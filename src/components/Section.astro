---
interface Props {
  id: string
  eyebrow: string
  title: string
  class?: string
}

const { id, eyebrow, title, class: className } = Astro.props
---

<section id={id} class:list={['border-t border-edge py-16 sm:py-24', className]}>
  <div class="mx-auto w-full max-w-5xl px-6">
    <header class="mb-10 sm:mb-12">
      <p class="mb-3 font-mono text-xs tracking-[0.18em] text-accent uppercase">{eyebrow}</p>
      <h2 class="text-2xl font-bold tracking-tight text-balance sm:text-3xl">{title}</h2>
    </header>

    <slot />
  </div>
</section>
