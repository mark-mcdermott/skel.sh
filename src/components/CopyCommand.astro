---
interface Props {
  command: string
  /** Visual weight. `lead` is the hero's primary call to action. */
  variant?: 'lead' | 'inline'
}

const { command, variant = 'inline' } = Astro.props
const isLead = variant === 'lead'
---

<div
  class:list={[
    'group flex items-start gap-3 rounded-xl border transition-colors',
    isLead
      ? 'border-edge bg-surface-sunk py-2.5 pr-2.5 pl-4 hover:border-fg-muted/50'
      : 'border-edge bg-surface-sunk px-3 py-2 hover:border-fg-muted/40',
  ]}
  data-copy-command
>
  <!-- Wraps rather than scrolls. A clone URL is wider than a third of the
       install row, and an overflowing line just looked truncated — no scrollbar
       shows until you try, and the copy button sat on top of the cut. -->
  <code
    class:list={[
      'flex-1 py-0.5 font-mono leading-relaxed wrap-anywhere whitespace-pre-wrap text-fg',
      isLead ? 'text-[15px]' : 'text-[13px]',
    ]}
  >
    <span class="mr-2 select-none text-fg-muted" aria-hidden="true">$</span>{command}
  </code>

  <button
    type="button"
    class:list={[
      'relative shrink-0 cursor-pointer rounded-lg border border-transparent font-mono text-fg-muted transition-colors',
      'hover:border-edge hover:bg-surface hover:text-fg',
      isLead ? 'px-3 py-2 text-xs' : 'px-2 py-1.5 text-[11px]',
    ]}
    data-copy-button
    data-command={command}
    aria-label={`Copy "${command}" to clipboard`}
    aria-live="polite"
  >
    <span data-copy-idle>Copy</span>
    <span class="hidden text-accent" data-copy-done>Copied</span>
    <!-- Replaced with the platform's own shortcut on first run; the Mac form is
         the SSR default only because it is the narrower of the two. -->
    <span class="hidden text-fg-muted" data-copy-fallback>press ⌘C</span>
  </button>
</div>

<script>
  const RESET_MS = 2000

  // The page offers macOS *and* Linux installs, so telling every visitor to
  // press a key only one of them has would be its own small bug.
  const isApple = /mac|iphone|ipad|ipod/i.test(navigator.userAgent)
  const SHORTCUT = isApple ? 'press \u2318C' : 'press Ctrl+C'

  /**
   * Selects just the command text, so the shortcut we are about to suggest has
   * something to act on. Without this the fallback is only a label change and
   * the keystroke copies whatever was on the clipboard already — worse than
   * doing nothing, because it looks like it worked.
   *
   * The `$` prompt is a separate `select-none` span, so selecting the text node
   * rather than the whole `<code>` keeps it out of what gets copied.
   */
  function selectCommandText(button: HTMLElement) {
    const code = button.closest('[data-copy-command]')?.querySelector('code')
    const text = code && [...code.childNodes].find(
      (n) => n.nodeType === Node.TEXT_NODE && n.textContent?.trim(),
    )
    if (!text) return

    const range = document.createRange()
    range.selectNodeContents(text)

    const selection = window.getSelection()
    selection?.removeAllRanges()
    selection?.addRange(range)
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy-button]').forEach((button) => {
    const idle = button.querySelector<HTMLElement>('[data-copy-idle]')
    const done = button.querySelector<HTMLElement>('[data-copy-done]')
    const fallback = button.querySelector<HTMLElement>('[data-copy-fallback]')
    const command = button.dataset.command
    if (!idle || !done || !fallback || !command) return

    fallback.textContent = SHORTCUT

    let timer: ReturnType<typeof setTimeout> | undefined

    const show = (state: HTMLElement) => {
      idle.hidden = state !== idle
      done.classList.toggle('hidden', state !== done)
      fallback.classList.toggle('hidden', state !== fallback)

      clearTimeout(timer)
      timer = setTimeout(() => {
        idle.hidden = false
        done.classList.add('hidden')
        fallback.classList.add('hidden')
      }, RESET_MS)
    }

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(command)
        show(done)
      } catch {
        // Denied permission, or a non-secure context. Hand the command over
        // manually rather than failing silently — a click that changes nothing
        // reads as success, and the next paste is whatever was there before.
        selectCommandText(button)
        show(fallback)
      }
    })
  })
</script>
